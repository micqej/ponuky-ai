# Vyber aspoň jedného providera — ostatné nechaj prázdne
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_AI_API_KEY=AIza...

# Defaultný provider: openai | anthropic | google
